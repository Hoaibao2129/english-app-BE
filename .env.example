NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/study-english?retryWrites=true&w=majority
# Groq API key (optional; if not provided, grading will be ungraded)
GROQ_API_KEY=
GROQ_MODEL=
# JWT signing secret (required, at least 32 characters)
JWT_SECRET=
# Token lifetimes: <number><s|m|h|d>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1d
# Comma-separated allowed browser origins, e.g. https://study-english.vercel.app,http://localhost:5173
# Optional in development/test (unset = allow all); REQUIRED when NODE_ENV=production
CORS_ORIGINS=
# SMTP settings for sending OTP emails (Gmail: smtp.gmail.com, port 465, app password)
# Optional in development/test (unset = emails are not sent); REQUIRED when NODE_ENV=production
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
